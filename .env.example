# ============================================================
# Modele de configuration. Copiez ce fichier en ".env" et
# remplacez les valeurs entre crochets.
#   .env est ignore par git : il ne part jamais sur GitHub.
# ============================================================

# Ou trouver ces chaines :
#   Supabase Dashboard > votre projet > Connect (bouton en haut)
#
#   DATABASE_URL = onglet "Transaction pooler" (port 6543) -> l'application
#   DIRECT_URL   = onglet "Session pooler"     (port 5432) -> les migrations
#
# Gardez "?pgbouncer=true&connection_limit=1" a la fin de DATABASE_URL :
# sans lui, chaque fonction serverless ouvre son propre pool et sature
# le pooler Supabase.

DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ============================================================
# Acces a l'application (agent securite)
# ============================================================
# Generer chaque valeur avec (une valeur differente pour chacune) :
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# Ne jamais la coller dans un message, un ticket ou un document.

# Secret de signature des cookies : 32 caracteres minimum, aleatoire.
# Le changer DECONNECTE IMMEDIATEMENT toutes les tablettes (il faudra
# retaper CODE_TABLETTE sur chacune) et ferme tous les acces gerant.
SESSION_SECRET="[A-GENERER]"

# Code de la tablette : 8 caracteres minimum. Tape UNE SEULE FOIS sur
# /connexion a l'installation de chaque tablette ; ensuite la tablette reste
# ouverte (180 jours, prolonges a chaque usage).
# Le changer DECONNECTE IMMEDIATEMENT toutes les tablettes (tablette perdue,
# volee, ou code divulgue).
# En dessous de 8 caracteres : plus aucune tablette ne s'installe
# (reference CONF-TABLETTE).
CODE_TABLETTE="[A-GENERER]"

# Code gerant : 8 caracteres minimum. Demande seulement pour changer les prix,
# les produits et les gateaux ; l'acces gerant se referme apres 30 minutes
# sans action. L'ANCIEN CODE A 4 CHIFFRES EST PUBLIC (historique git) : il est
# refuse, il faut en choisir un nouveau. En dessous de 8 caracteres : plus
# aucun acces gerant (reference CONF-GESTION). Le changer ferme tous les
# acces gerant ouverts.
CODE_GESTION="[A-GENERER]"

# ============================================================
# Imprimante Star CloudPRNT
# ============================================================
# Cle placee dans l'URL configuree dans l'imprimante :
#   https://<site>/api/cloudprnt/<CLOUDPRNT_CLE>
# 32 caracteres minimum, aleatoire (meme commande que ci-dessus). En dessous,
# l'imprimante est refusee. Ne jamais la coller dans un message ou un ticket.
CLOUDPRNT_CLE="[A-GENERER]"
