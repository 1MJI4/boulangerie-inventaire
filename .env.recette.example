# ============================================================
# .env.recette.example — modèle de la configuration de RECETTE
# (agent `deploiement`, guide : docs/RECETTE.md)
#
# Le vrai fichier « .env.recette » est créé TOUT SEUL par
#   npm run recette:base
# avec des codes tirés au hasard. Il est ignoré par git.
#
# INTERDIT : mettre ici, ou dans .env.recette, une adresse Supabase ou
# toute autre base que la base Docker locale. Le lanceur
# (scripts/recette.mjs) refuse de démarrer si l'hôte n'est pas
# localhost / 127.0.0.1 ou si le nom de base ne contient pas « recette ».
# ============================================================

# Base Docker locale (docker-compose.recette.yml) — identifiants de test.
DATABASE_URL="postgresql://recette:recette_locale_sans_valeur@localhost:55432/pain_recette?schema=public"
DIRECT_URL="postgresql://recette:recette_locale_sans_valeur@localhost:55432/pain_recette?schema=public"

# Codes de TEST (jamais ceux de la production). Longueurs minimales :
#   SESSION_SECRET ≥ 32 · CODE_TABLETTE ≥ 8 · CODE_GESTION ≥ 8 · CLOUDPRNT_CLE ≥ 32
SESSION_SECRET="[GÉNÉRÉ PAR recette:base]"
CODE_TABLETTE="[GÉNÉRÉ PAR recette:base]"
CODE_GESTION="[GÉNÉRÉ PAR recette:base]"
CLOUDPRNT_CLE="[GÉNÉRÉ PAR recette:base]"

# Photos modèles de la galerie (ajoutées par le gérant depuis la tablette).
# Dossier de DONNÉES, hors de public/ et ignoré par git. Chemin ABSOLU, écrit
# par recette:base (par défaut <projet>/donnees/modeles). Rempli UNE fois avec
# les images de public/modeles/ par recette:donnees (jamais d'écrasement).
DOSSIER_PHOTOS_MODELES="[POSÉ PAR recette:base]"
