# deploiement/vps/pain-sauvegarde.service — sauvegarde vérifiée (base + photos modèles).
# Installé par installer.sh dans /etc/systemd/system/, déclenché par pain-sauvegarde.timer.
# Résultat : journalctl -u pain-sauvegarde · cat /var/backups/pain-patisserie/DERNIERE-VERIFICATION
[Unit]
Description=Pain Patisserie - sauvegarde verifiee (base + photos modeles)
After=postgresql.service

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/pain-patisserie/deploiement/vps/sauvegarder.sh
Nice=10
IOSchedulingClass=idle
